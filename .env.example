# AEGIS environment configuration
# Copy this file to .env and fill in the values.

# NASA API key from https://api.nasa.gov (DEMO_KEY works, but is rate-limited)
NASA_API_KEY=your_nasa_api_key_here

# Optional: enables AI-generated flight briefings. Leave blank to use the
# deterministic telemetry-based briefing instead.
ANTHROPIC_API_KEY=

# Local development: 3001 (the Vite dev server proxies /api here).
# Production on Nest: 80 (the port registered in the Nest dashboard).
PORT=3001
